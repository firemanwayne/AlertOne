@namespace Domains.UserManagement.Lists

@inject IUserManagementService UserService
@inject IRoleManagementService RoleService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Elevation="1">
    <MudToolBar>
        <MudText Typo="Typo.h6">User Management</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="@LoadUsersAsync" />
    </MudToolBar>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="ma-4">@_errorMessage</MudAlert>
    }
    else if (_users == null || !_users.Any())
    {
        @if (!_isLoading)
        {
            <MudAlert Severity="Severity.Info" Class="ma-4">No users found.</MudAlert>
        }
    }
    else
    {
        <MudTextField T="string"
                      @bind-Value="_searchTerm"
                      Placeholder="Search by email or name..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="ma-4"
                      Immediate="true" />

        <MudTable Items="@FilteredUsers" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>First Name</MudTh>
                <MudTh>Last Name</MudTh>
                <MudTh>Roles</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="First Name">@context.FirstName</MudTd>
                <MudTd DataLabel="Last Name">@context.LastName</MudTd>
                <MudTd DataLabel="Roles">
                    @foreach (var role in context.Roles)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mr-1">@role</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => OnEditUser(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => OnDeleteUser(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Badge"
                                   Size="Size.Small"
                                   Color="Color.Secondary"
                                   OnClick="@(() => OpenRolesDialogAsync(context))"
                                   Title="Manage Roles" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <MudText Typo="Typo.caption" Class="pa-4 mud-text-secondary">
            Showing @FilteredUsers.Count() of @_users.Count() users
        </MudText>
    }
</MudPaper>

@code {
    [Parameter]
    public EventCallback<UserResponse> OnEdit { get; set; }

    [Parameter]
    public EventCallback<UserResponse> OnDelete { get; set; }

    private List<UserResponse>? _users;
    private bool _isLoading = false;
    private string? _errorMessage;
    private string _searchTerm = string.Empty;

    private IEnumerable<UserResponse> FilteredUsers
    {
        get
        {
            if (_users == null)
            {
                return Enumerable.Empty<UserResponse>();
            }

            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _users;
            }

            var searchLower = _searchTerm.ToLowerInvariant();
            return _users.Where(u =>
                u.Email.ToLowerInvariant().Contains(searchLower) ||
                u.FirstName.ToLowerInvariant().Contains(searchLower) ||
                u.LastName.ToLowerInvariant().Contains(searchLower));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await UserService.GetAllUsersAsync();

            if (result.IsSuccess)
            {
                _users = result.Value.ToList();
            }
            else
            {
                _errorMessage = result.Error?.Message ?? "Failed to load users";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnEditUser(UserResponse user)
    {
        await OnEdit.InvokeAsync(user);
    }

    private async Task OnDeleteUser(UserResponse user)
    {
        await OnDelete.InvokeAsync(user);
    }

    public async Task RefreshAsync()
    {
        await LoadUsersAsync();
    }

    private async Task OpenRolesDialogAsync(UserResponse user)
    {
        var parameters = new DialogParameters<ManageRolesDialog>
        {
            { x => x.User, user },
            { x => x.RoleService, RoleService },
            { x => x.UserService, UserService }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ManageRolesDialog>($"Manage Roles - {user.Email}", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadUsersAsync();
        }
    }
}
