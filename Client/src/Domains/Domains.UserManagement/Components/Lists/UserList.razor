@namespace Domains.UserManagement.Lists

@inject IUserManagementService UserService
@inject IRoleManagementService RoleService

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">User Management</h3>
        <button class="btn btn-primary btn-sm" @onclick="@LoadUsersAsync">
            <span class="me-1">🔄</span> Refresh
        </button>
    </div>
    <div class="card-body">
        @if (_isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading users...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @_errorMessage
            </div>
        }
        else if (_users == null || !_users.Any())
        {
            <div class="alert alert-info" role="alert">
                No users found.
            </div>
        }
        else
        {
            <div class="mb-3">
                <input type="text" class="form-control" placeholder="Search by email or name..." @bind="_searchTerm" @bind:event="oninput" />
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Roles</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr>
                                <td>@user.Email</td>
                                <td>@user.FirstName</td>
                                <td>@user.LastName</td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-primary me-1">@role</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => OnEditUser(user))">
                                        Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger me-1" @onclick="@(() => OnDeleteUser(user))">
                                        Delete
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => OpenRolesModalAsync(user))">
                                        Roles
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <p class="text-muted">Showing @FilteredUsers.Count() of @_users.Count() users</p>
            </div>
        }
    </div>
</div>

@if (_showRolesModal && _managingRolesUser != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Manage Roles — @_managingRolesUser.Email</h5>
                    <button type="button" class="btn-close" @onclick="CloseRolesModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_rolesModalError))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_rolesModalError
                        </div>
                    }

                    <h6>Current Roles</h6>
                    @if (_managingRolesUser.Roles.Any())
                    {
                        <div class="mb-3">
                            @foreach (var role in _managingRolesUser.Roles)
                            {
                                <span class="badge bg-primary me-1">
                                    @role
                                    <button type="button"
                                            class="btn-close btn-close-white ms-1"
                                            style="font-size: 0.6rem;"
                                            aria-label="Remove @role"
                                            disabled="@_isSavingRole"
                                            @onclick="@(() => RemoveRoleFromUserAsync(role))">
                                    </button>
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-3">No roles assigned.</p>
                    }

                    <h6>Add Role</h6>
                    @{
                        var unassignedRoles = _availableRoles
                            .Where(r => !_managingRolesUser.Roles.Contains(r.Name))
                            .ToList();
                    }
                    @if (unassignedRoles.Any())
                    {
                        <div class="d-flex gap-2">
                            <select class="form-select" @bind="_selectedRoleToAdd" disabled="@_isSavingRole">
                                <option value="">— Select a role —</option>
                                @foreach (var role in unassignedRoles)
                                {
                                    <option value="@role.Name">@role.Name</option>
                                }
                            </select>
                            <button class="btn btn-primary"
                                    @onclick="AssignRoleToUserAsync"
                                    disabled="@(string.IsNullOrEmpty(_selectedRoleToAdd) || _isSavingRole)">
                                @if (_isSavingRole)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <span>Add Role</span>
                                }
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">All available roles are already assigned.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseRolesModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public EventCallback<UserResponse> OnEdit { get; set; }

    [Parameter]
    public EventCallback<UserResponse> OnDelete { get; set; }

    private List<UserResponse>? _users;
    private bool _isLoading = false;
    private string? _errorMessage;
    private string _searchTerm = string.Empty;

    private UserResponse? _managingRolesUser = null;
    private bool _showRolesModal = false;
    private bool _isSavingRole = false;
    private string? _rolesModalError;
    private List<RoleResponse> _availableRoles = new();
    private string _selectedRoleToAdd = string.Empty;

    private IEnumerable<UserResponse> FilteredUsers
    {
        get
        {
            if (_users == null)
            {
                return Enumerable.Empty<UserResponse>();
            }

            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _users;
            }

            var searchLower = _searchTerm.ToLowerInvariant();
            return _users.Where(u =>
                u.Email.ToLowerInvariant().Contains(searchLower) ||
                u.FirstName.ToLowerInvariant().Contains(searchLower) ||
                u.LastName.ToLowerInvariant().Contains(searchLower));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await UserService.GetAllUsersAsync();

            if (result.IsSuccess)
            {
                _users = result.Value.ToList();
            }
            else
            {
                _errorMessage = result.Error?.Message ?? "Failed to load users";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnEditUser(UserResponse user)
    {
        await OnEdit.InvokeAsync(user);
    }

    private async Task OnDeleteUser(UserResponse user)
    {
        await OnDelete.InvokeAsync(user);
    }

    public async Task RefreshAsync()
    {
        await LoadUsersAsync();
    }

    private async Task OpenRolesModalAsync(UserResponse user)
    {
        _managingRolesUser = user;
        _rolesModalError = null;
        _selectedRoleToAdd = string.Empty;

        if (!_availableRoles.Any())
        {
            var result = await RoleService.GetAllRolesAsync();

            if (result.IsSuccess)
            {
                _availableRoles = result.Value.ToList();
            }
        }

        _showRolesModal = true;
    }

    private void CloseRolesModal()
    {
        _showRolesModal = false;
        _managingRolesUser = null;
        _rolesModalError = null;
        _selectedRoleToAdd = string.Empty;
    }

    private async Task AssignRoleToUserAsync()
    {
        if (_managingRolesUser == null || string.IsNullOrEmpty(_selectedRoleToAdd))
        {
            return;
        }

        _isSavingRole = true;
        _rolesModalError = null;

        try
        {
            var request = new AssignRoleRequest(_managingRolesUser.Id, _selectedRoleToAdd);
            var result = await RoleService.AssignRoleAsync(request);

            if (result.IsSuccess)
            {
                await RefreshUserInListAsync(_managingRolesUser.Id);
                _selectedRoleToAdd = string.Empty;
            }
            else
            {
                _rolesModalError = result.Error?.Message ?? "Failed to assign role";
            }
        }
        catch (Exception ex)
        {
            _rolesModalError = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isSavingRole = false;
        }
    }

    private async Task RemoveRoleFromUserAsync(string roleName)
    {
        if (_managingRolesUser == null)
        {
            return;
        }

        _isSavingRole = true;
        _rolesModalError = null;

        try
        {
            var request = new AssignRoleRequest(_managingRolesUser.Id, roleName);
            var result = await RoleService.RemoveRoleAsync(request);

            if (result.IsSuccess)
            {
                await RefreshUserInListAsync(_managingRolesUser.Id);
            }
            else
            {
                _rolesModalError = result.Error?.Message ?? "Failed to remove role";
            }
        }
        catch (Exception ex)
        {
            _rolesModalError = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isSavingRole = false;
        }
    }

    private async Task RefreshUserInListAsync(Guid userId)
    {
        var result = await UserService.GetUserByIdAsync(userId);

        if (result.IsSuccess && _users != null)
        {
            var updatedUser = result.Value;
            var index = _users.FindIndex(u => u.Id == userId);

            if (index >= 0)
            {
                _users[index] = updatedUser;
            }

            _managingRolesUser = updatedUser;
        }
    }
}
