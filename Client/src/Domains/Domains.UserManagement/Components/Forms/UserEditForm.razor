@namespace Domains.UserManagement.Forms

@inject IUserManagementService UserService
@inject ISnackbar Snackbar

<MudCard Elevation="2">
    <MudCardHeader>
        <MudText Typo="Typo.h6">Edit User</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudTextField T="string"
                          Value="@User?.Email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          Disabled="true"
                          ReadOnly="true"
                          HelperText="Email cannot be changed"
                          Class="mb-4" />

            <MudTextField T="string"
                          @bind-Value="_editModel.FirstName"
                          Label="First Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="First name is required"
                          Class="mb-4" />

            <MudTextField T="string"
                          @bind-Value="_editModel.LastName"
                          Label="Last Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Last name is required"
                          Class="mb-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Roles</MudText>
            <div class="mb-4">
                @if (User?.Roles != null && User.Roles.Any())
                {
                    @foreach (var role in User.Roles)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mr-1">@role</MudChip>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No roles assigned</MudText>
                }
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Use role management to change user roles</MudText>
        </MudForm>
    </MudCardContent>
    <MudCardActions Class="pa-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!_formIsValid || _isLoading)"
                   OnClick="@HandleUpdateAsync">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save Changes</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="@OnCancelClicked"
                   Disabled="@_isLoading"
                   Class="ml-2">
            Cancel
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter]
    public UserResponse? User { get; set; }

    [Parameter]
    public EventCallback OnSaveSuccess { get; set; }

    [Parameter]
    public EventCallback OnCancelClicked { get; set; }

    private MudForm _form = null!;
    private EditModel _editModel = new();
    private bool _isLoading = false;
    private bool _formIsValid = false;

    protected override void OnParametersSet()
    {
        if (User != null)
        {
            _editModel = new EditModel
            {
                FirstName = User.FirstName,
                LastName = User.LastName
            };
        }
    }

    private async Task HandleUpdateAsync()
    {
        if (User == null)
        {
            return;
        }

        await _form.Validate();

        if (!_form.IsValid)
        {
            return;
        }

        _isLoading = true;

        try
        {
            var request = new UpdateUserRequest(
                _editModel.FirstName,
                _editModel.LastName
            );

            var result = await UserService.UpdateUserAsync(User.Id, request);

            if (result.IsSuccess)
            {
                Snackbar.Add("User updated successfully", Severity.Success);
                await OnSaveSuccess.InvokeAsync();
            }
            else
            {
                Snackbar.Add(result.Error?.Message ?? "Update failed. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class EditModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
    }
}
