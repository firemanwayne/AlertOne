@page "/users"
@attribute [Authorize]

@inject IUserManagementService UserService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Users</MudText>

    <UserList @ref="_userListRef"
              OnEdit="@HandleEditUser"
              OnDelete="@HandleDeleteUser" />
</MudContainer>

@code {
    private UserList? _userListRef;

    private void HandleEditUser(UserResponse user)
    {
        Navigation.NavigateTo($"/users/edit/{user.Id}");
    }

    private async Task HandleDeleteUser(UserResponse user)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete user '{user.Email}'?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete User", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            var deleteResult = await UserService.DeleteUserAsync(user.Id);

            if (deleteResult.IsSuccess)
            {
                Snackbar.Add($"User '{user.Email}' deleted successfully", Severity.Success);

                if (_userListRef != null)
                {
                    await _userListRef.RefreshAsync();
                }
            }
            else
            {
                Snackbar.Add($"Failed to delete user: {deleteResult.Error?.Message}", Severity.Error);
            }
        }
    }
}
