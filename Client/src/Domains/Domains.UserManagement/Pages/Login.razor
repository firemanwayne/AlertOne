@page "/login"
@attribute [AllowAnonymous]

@inject AppState AppState
@inject NavigationManager Navigation
@inject IAuthenticationService AuthService

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }
    else if (AppState.IsAuthenticated)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            <MudText Typo="Typo.h6">Already Logged In</MudText>
            <MudText>You are already logged in as @AppState.CurrentUser?.Email</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="mt-2">Go to Home</MudButton>
        </MudAlert>
    }
    else
    {
        <LoginForm OnLoginSuccess="@HandleLoginSuccess" />

        @if (!_hasUsers)
        {
            <MudPaper Class="mt-4 pa-4" Elevation="2">
                <MudText Typo="Typo.body1" Class="mb-2">No users exist in the system yet.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" Href="/register">
                    Create First User
                </MudButton>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private bool _isLoading = true;
    private bool _hasUsers = true;

    protected override async Task OnInitializedAsync()
    {
        await CheckForUsersAsync();
    }

    private async Task CheckForUsersAsync()
    {
        try
        {
            var result = await AuthService.HasUsersAsync();

            if (result.IsSuccess)
            {
                _hasUsers = result.Value;
            }
        }
        catch
        {
            // If check fails, assume users exist (safer default)
            _hasUsers = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleLoginSuccess()
    {
        Navigation.NavigateTo("/");

        await InvokeAsync(StateHasChanged);
    }
}
