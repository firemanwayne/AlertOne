@page "/roles/create"
@attribute [Authorize]

@inject IRoleManagementService RoleService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <MudButton Variant="Variant.Text"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => Navigation.NavigateTo("/roles"))"
               Class="mb-4">
        Back to Roles
    </MudButton>

    <MudCard Elevation="2">
        <MudCardHeader>
            <MudText Typo="Typo.h6">Create New Role</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
                <MudTextField T="string"
                              @bind-Value="_editModel.Name"
                              Label="Role Name"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Role name is required"
                              MaxLength="100"
                              Class="mb-4" />
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="pa-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(!_formIsValid || _isLoading)"
                       OnClick="@HandleSubmitAsync">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Creating...</span>
                }
                else
                {
                    <span>Create Role</span>
                }
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="@(() => Navigation.NavigateTo("/roles"))"
                       Disabled="@_isLoading"
                       Class="ml-2">
                Cancel
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm _form = null!;
    private EditModel _editModel = new();
    private bool _isLoading = false;
    private bool _formIsValid = false;

    private async Task HandleSubmitAsync()
    {
        await _form.Validate();

        if (!_form.IsValid)
        {
            return;
        }

        _isLoading = true;

        try
        {
            var result = await RoleService.CreateRoleAsync(new CreateRoleRequest(_editModel.Name));

            if (result.IsSuccess)
            {
                Snackbar.Add("Role created successfully", Severity.Success);
                Navigation.NavigateTo("/roles");
            }
            else
            {
                Snackbar.Add(result.Error?.Message ?? "Failed to create role", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class EditModel
    {
        public string Name { get; set; } = string.Empty;
    }
}
