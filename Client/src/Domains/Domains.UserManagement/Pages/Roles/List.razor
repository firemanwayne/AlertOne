@page "/roles"
@attribute [Authorize]

@inject IRoleManagementService RoleService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="1">
        <MudToolBar>
            <MudText Typo="Typo.h6">Role Management</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Small"
                       OnClick="@(() => Navigation.NavigateTo("/roles/create"))">
                Create New Role
            </MudButton>
        </MudToolBar>

        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="ma-4">@_errorMessage</MudAlert>
        }
        else if (_roles == null || !_roles.Any())
        {
            @if (!_isLoading)
            {
                <MudAlert Severity="Severity.Info" Class="ma-4">No roles found.</MudAlert>
            }
        }
        else
        {
            <MudTable Items="@_roles" Hover="true" Striped="true" Dense="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Users</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="Users">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                            @context.UserCount user(s)
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteRoleAsync(context))"
                                   Disabled="@(_deletingRoleId == context.Id)">
                            @if (_deletingRoleId == context.Id)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                <span>Deleting...</span>
                            }
                            else
                            {
                                <span>Delete</span>
                            }
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    private List<RoleResponse>? _roles;
    private bool _isLoading = false;
    private string? _errorMessage;
    private Guid? _deletingRoleId;

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await RoleService.GetAllRolesAsync();

            if (result.IsSuccess)
            {
                _roles = result.Value.ToList();
            }
            else
            {
                _errorMessage = result.Error?.Message ?? "Failed to load roles";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteRoleAsync(RoleResponse role)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete role '{role.Name}'?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Role", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            _deletingRoleId = role.Id;
            _errorMessage = null;

            try
            {
                var deleteResult = await RoleService.DeleteRoleAsync(role.Id);

                if (deleteResult.IsSuccess)
                {
                    Snackbar.Add($"Role '{role.Name}' deleted successfully", Severity.Success);
                    await LoadRolesAsync();
                }
                else
                {
                    Snackbar.Add(deleteResult.Error?.Message ?? "Failed to delete role", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
            }
            finally
            {
                _deletingRoleId = null;
            }
        }
    }
}
