@page "/"
@attribute [Authorize]

@inject AppState AppState

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center">
                    <h2>Welcome, @AppState.CurrentUser?.FullName!</h2>
                    <p class="text-muted">@AppState.CurrentUser?.Email</p>
                    <div class="mt-3">
                        @if (AppState.CurrentUser?.Roles != null)
                        {
                            @foreach (var role in AppState.CurrentUser.Roles)
                            {
                                <span class="badge bg-primary me-1">@role</span>
                            }
                        }
                    </div>
                    <hr />
                    <a href="/users" class="btn btn-primary">Manage Users</a>
                </div>
            </div>
        </div>
    </div>
</div>
