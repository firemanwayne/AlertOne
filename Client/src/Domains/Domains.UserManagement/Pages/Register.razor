@page "/register"
@attribute [AllowAnonymous]

@inject AppState AppState
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    @if (AppState.IsAuthenticated)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            <MudText Typo="Typo.h6">Already Logged In</MudText>
            <MudText>You are already logged in as @AppState.CurrentUser?.Email</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="mt-2">Go to Home</MudButton>
        </MudAlert>
    }
    else
    {
        <RegisterForm OnRegisterSuccess="@HandleRegisterSuccess" OnLoginClicked="@HandleLoginClicked" />
    }
</MudContainer>

@code {
    private async Task HandleRegisterSuccess()
    {
        Navigation.NavigateTo("/");
        await InvokeAsync(StateHasChanged);
    }

    private void HandleLoginClicked()
    {
        Navigation.NavigateTo("/login");
    }
}
