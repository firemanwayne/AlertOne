@namespace Domains.AlertManagement.Lists

@inject IAlertStatusLevelService AlertStatusLevelService

<MudPaper Elevation="1">
    <MudToolBar>
        <MudText Typo="Typo.h6">Alert Status Levels</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="@LoadAsync" />
    </MudToolBar>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="ma-4">@_errorMessage</MudAlert>
    }
    else if (!_levels.Any() && !_isLoading)
    {
        <MudAlert Severity="Severity.Info" Class="ma-4">No alert status levels defined.</MudAlert>
    }
    else
    {
        <MudTable Items="@_levels" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
                <MudTh>Color</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Notifications</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudAvatar Size="Size.Small" Style="@($"background-color: {context.Color}")"> </MudAvatar>
                </MudTd>
                <MudTd DataLabel="Name">
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Name</MudText>
                </MudTd>
                <MudTd DataLabel="Description">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Description</MudText>
                </MudTd>
                <MudTd DataLabel="Notifications">
                    @if (context.SendNotifications)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Enabled</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">Disabled</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Type">
                    @if (context.IsDefault)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">Default</MudChip>
                    }
                    @if (context.IsCanceled)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">Canceled</MudChip>
                    }
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => OnEdit.InvokeAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => OnDelete.InvokeAsync(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    [Parameter]
    public EventCallback<AlertStatusLevelViewModel> OnEdit { get; set; }

    [Parameter]
    public EventCallback<AlertStatusLevelViewModel> OnDelete { get; set; }

    private List<AlertStatusLevelViewModel> _levels = new();
    private bool _isLoading = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await AlertStatusLevelService.GetAllAsync();

            if (result.IsSuccess)
            {
                _levels = result.Value
                    .Select(AlertStatusLevelViewModel.FromResponse)
                    .ToList();
            }
            else
            {
                _errorMessage = result.Error?.Message ?? "Failed to load status levels.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public async Task RefreshAsync()
    {
        await LoadAsync();
    }
}
