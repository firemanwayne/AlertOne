@namespace Domains.AlertManagement
@using AlertOne.Core.Attributes

@inject IAlertService AlertService
@inject IAlertTypeService AlertTypeService
@inject AppState AppState
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@if (_isLoading)
{
    <div class="d-flex align-center gap-2">
        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Loading alerts...</MudText>
    </div>
}
else
{
    <div class="alert-panel">

        @foreach (var activeAlert in _activeAlerts)
        {
            var style = $"border: 2px solid {activeAlert.Type.BackgroundColor};";
            var mudHeaderStyle = $"background-color: {activeAlert.Type.BackgroundColor}; color: {activeAlert.Type.TextColor};";

            <MudCard Elevation="2" Style="@style" @onclick="@(() => NavigateToDashboard(activeAlert.Id))">
                <MudCardHeader Style="@mudHeaderStyle">

                    <CardHeaderContent>
                        <div class="d-flex flex-column flex-sm-row align-center gap-2 w-100">
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" />
                                <MudText Typo="Typo.h6" Class="font-weight-bold">ACTIVE ALERT</MudText>
                                <MudChip T="string"
                                         Style="@($"background-color: {activeAlert.StatusLevel.BackgroundColor}; color: {activeAlert.StatusLevel.TextColor};")"
                                         Size="Size.Small">
                                    @activeAlert.StatusLevel.Name
                                </MudChip>
                            </div>
                            @if (_isManager)
                            {
                                <div class="mt-2 mt-sm-0 ml-sm-auto">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               OnClick="@(() => HandleRescindAsync(activeAlert.Id))"
                                               Disabled="@_isSubmitting">
                                        @if (_isSubmitting)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                        }
                                        Rescind Alert
                                    </MudButton>
                                </div>
                            }
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@activeAlert.Type.Name</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@activeAlert.Type.Description</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6" Class="d-flex flex-column text-center">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Activated by <strong>@activeAlert.CreatedBy</strong>
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @activeAlert.CreatedDate.ToString("MMM d, yyyy h:mm tt")
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>

                @if (!_isManager)
                {
                    <MudCardContent Class="pt-0">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Only managers can rescind this alert.
                        </MudText>
                    </MudCardContent>
                }

            </MudCard>
        }
    </div>
}

@if (_showActivateForm)
{
    <div class="alert-panel">
        <MudCard Elevation="3">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Activate Alert</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Warning"
                                   OnClick="@CancelActivate" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
                    <MudSelect T="string"
                               @bind-Value="_activateModel.TypeId"
                               Label="Alert Type"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="Please select an alert type"
                               Class="mb-4">
                        @foreach (var type in _alertTypes)
                        {
                            <MudSelectItem Value="@type.Id">@type.Name</MudSelectItem>
                        }
                    </MudSelect>

                    @if (!string.IsNullOrEmpty(_activateModel.TypeId))
                    {
                        var selected = _alertTypes
                        .FirstOrDefault(t => t.Id == _activateModel.TypeId);

                        @if (selected != null)
                        {
                            var selectedCss = $"background-color: {selected.BackgroundColor}22; border-left: 4px solid {selected.BackgroundColor};";

                            <MudPaper Elevation="0"
                                      Class="pa-3 mb-4"
                                      Style="@(selectedCss)">
                                <MudText Typo="Typo.body2">@selected.Description</MudText>
                            </MudPaper>
                        }
                    }
                </MudForm>
            </MudCardContent>
            <MudCardActions Class="pa-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           OnClick="@HandleActivateAsync"
                           Disabled="@(!_formIsValid || _isSubmitting)">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Activating...</span>
                    }
                    else
                    {
                        <span>Activate Alert</span>
                    }
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           OnClick="@CancelActivate"
                           Disabled="@_isSubmitting"
                           Class="ml-2">
                    Cancel
                </MudButton>
            </MudCardActions>
        </MudCard>
    </div>
}
else
{
    <div class="alert-panel" style="padding-top:50px;">
        <div class="d-flex align-center gap-3">
            @if(_activeAlerts.Count == 0)
            {
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                <MudText Typo="Typo.body2">No active alerts</MudText>
            </div>
            }
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       Size="Size.Small"
                       OnClick="@ShowActivateForm">
                Activate Alert
            </MudButton>
        </div>
    </div>
}


@code {
    [Parameter]
    public EventCallback OnAlertChanged { get; set; }

    private List<AlertViewModel> _activeAlerts = [];

    private List<AlertTypeViewModel> _alertTypes = new();

    private bool _isLoading = true;

    private bool _isSubmitting = false;

    private bool _showActivateForm = false;

    private bool _formIsValid = false;

    private MudForm _form = null!;

    private bool _isManager =>
        AppState.CurrentUser?.Roles.Contains("Manager", StringComparer.OrdinalIgnoreCase) == true;

    private ActivateModel _activateModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            var alertsTask = AlertService.GetAllAsync();

            var typesTask = AlertTypeService.GetAllAsync();

            await Task.WhenAll(alertsTask, typesTask);

            if (alertsTask.Result.IsSuccess)
            {
                _activeAlerts = alertsTask.Result.Value
                    .Where(a => a.IsActive)
                    .OrderByDescending(a => a.CreatedDate)
                    .Select(AlertViewModel.FromResponse)
                    .ToList();
            }

            if (typesTask.Result.IsSuccess)
            {
                _alertTypes = typesTask.Result.Value
                    .Select(AlertTypeViewModel.FromResponse)
                    .ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowActivateForm()
    {
        _activateModel = new ActivateModel();

        _showActivateForm = true;
    }

    private void CancelActivate()
    {
        _showActivateForm = false;
    }

    private async Task HandleActivateAsync()
    {
        if (_form != null)
        {
            await _form.Validate();

            if (!_form.IsValid)
            {
                return;
            }
        }

        _isSubmitting = true;

        try
        {
            var request = new CreateAlertRequest(
                _activateModel.TypeId,
                AppState.CurrentUser?.Email ?? string.Empty);

            var result = await AlertService.CreateAsync(request);

            if (result.IsSuccess)
            {
                _activeAlerts
                .Add(AlertViewModel.FromResponse(result.Value));

                Snackbar.Add("Alert activated successfully", Severity.Success);

                await OnAlertChanged.InvokeAsync();
            }
            else
            {
                Snackbar.Add(result.Error?.Message ?? "Failed to activate alert", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleRescindAsync(string alertId)
    {
        _isSubmitting = true;

        try
        {
            var rescindRequest = new RescindAlertRequest(AppState.CurrentUser?.Email ?? string.Empty);

            var result = await AlertService.RescindAsync(alertId, rescindRequest);

            if (result.IsSuccess)
            {
                await RefreshAsync();

                Snackbar.Add("Alert rescinded successfully", Severity.Success);

                await OnAlertChanged.InvokeAsync();
            }
            else
            {
                Snackbar.Add(result.Error?.Message ?? "Failed to rescind alert", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public async Task RefreshAsync()
    {
        await LoadAsync();
    }

    private void NavigateToDashboard(string id) => Nav.NavigateTo($"/alerts/{id}");

    private sealed class ActivateModel
    {
        public string TypeId { get; set; } = string.Empty;
    }
}
