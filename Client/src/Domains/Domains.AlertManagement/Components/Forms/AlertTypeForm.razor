@namespace Domains.AlertManagement.Forms

@inject IAlertTypeService AlertTypeService
@inject IUserManagementService UserService
@inject ISnackbar Snackbar

<MudCard Elevation="2">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@(AlertType == null ? "Create Alert Type" : "Edit Alert Type")</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudTextField T="string"
                          @bind-Value="_model.Name"
                          Label="Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Name is required"
                          MaxLength="100"
                          HelperText="e.g. Fire, Medical, Security"
                          Class="mb-4" />

            <MudTextField T="string"
                          @bind-Value="_model.Description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Required="true"
                          RequiredError="Description is required"
                          MaxLength="500"
                          HelperText="Describe what this alert type represents..."
                          Class="mb-4" />

            <div class="d-flex align-center gap-4 mb-4">
                <MudColorPicker @bind-Text="_model.Color"
                                Label="Color"
                                Variant="Variant.Outlined"
                                DisableToolbar="false"
                                DisableAlpha="true"
                                Style="max-width: 200px;" />

                <MudChip T="string"
                         Style="@($"background-color: {_model.Color}; color: #fff;")"
                         Size="Size.Large">
                    Preview
                </MudChip>
            </div>

            <MudText Typo="Typo.subtitle2" Class="mb-2">Notify Users</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                Select the users who will receive notifications when this alert type is activated.
            </MudText>

            @if (_isLoadingUsers)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
            }
            else if (!_allUsers.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">No users available.</MudAlert>
            }
            else
            {
                <MudPaper Elevation="0" Class="pa-3 mb-4" Style="max-height: 220px; overflow-y: auto; border: 1px solid var(--mud-palette-lines-default);">
                    <MudTextField T="string"
                                  @bind-Value="_userSearch"
                                  Placeholder="Search users..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Class="mb-2" />

                    @foreach (var user in FilteredUsers)
                    {
                        var isChecked = _model.NotifyUserIds.Contains(user.Id.ToString());
                        <MudCheckBox T="bool"
                                     Value="@isChecked"
                                     ValueChanged="@(val => ToggleUser(user.Id.ToString(), val))"
                                     Label="@($"{user.FirstName} {user.LastName} ({user.Email})")"
                                     Color="Color.Primary"
                                     Dense="true" />
                    }
                </MudPaper>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @_model.NotifyUserIds.Count user(s) selected
                </MudText>
            }
        </MudForm>
    </MudCardContent>
    <MudCardActions Class="pa-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!_formIsValid || _isLoading)"
                   OnClick="@HandleSubmitAsync">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>@(AlertType == null ? "Create" : "Save Changes")</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="@OnCancelClicked"
                   Disabled="@_isLoading"
                   Class="ml-2">
            Cancel
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter]
    public AlertTypeViewModel? AlertType { get; set; }

    [Parameter]
    public EventCallback OnSaveSuccess { get; set; }

    [Parameter]
    public EventCallback OnCancelClicked { get; set; }

    private MudForm _form = null!;
    private FormModel _model = new();
    private List<UserResponse> _allUsers = new();
    private bool _isLoading = false;
    private bool _isLoadingUsers = false;
    private bool _formIsValid = false;
    private string _userSearch = string.Empty;

    private IEnumerable<UserResponse> FilteredUsers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_userSearch))
            {
                return _allUsers;
            }

            var term = _userSearch.ToLowerInvariant();
            return _allUsers.Where(u =>
                u.Email.ToLowerInvariant().Contains(term) ||
                u.FirstName.ToLowerInvariant().Contains(term) ||
                u.LastName.ToLowerInvariant().Contains(term));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    protected override void OnParametersSet()
    {
        if (AlertType != null)
        {
            _model = new FormModel
            {
                Name = AlertType.Name,
                Description = AlertType.Description,
                Color = AlertType.Color,
                NotifyUserIds = AlertType.NotifyUserIds.ToList()
            };
        }
        else
        {
            _model = new FormModel();
        }
    }

    private async Task LoadUsersAsync()
    {
        _isLoadingUsers = true;

        try
        {
            var result = await UserService.GetAllUsersAsync();

            if (result.IsSuccess)
            {
                _allUsers = result.Value.ToList();
            }
        }
        catch
        {
            // Users list is non-critical; the form can still be submitted without it
        }
        finally
        {
            _isLoadingUsers = false;
        }
    }

    private void ToggleUser(string userId, bool selected)
    {
        if (selected)
        {
            if (!_model.NotifyUserIds.Contains(userId))
            {
                _model.NotifyUserIds.Add(userId);
            }
        }
        else
        {
            _model.NotifyUserIds.Remove(userId);
        }
    }

    private async Task HandleSubmitAsync()
    {
        await _form.Validate();

        if (!_form.IsValid)
        {
            return;
        }

        _isLoading = true;

        try
        {
            if (AlertType == null)
            {
                var request = new CreateAlertTypeRequest(
                    _model.Name,
                    _model.Description,
                    _model.Color,
                    _model.NotifyUserIds);

                var result = await AlertTypeService.CreateAsync(request);

                if (result.IsSuccess)
                {
                    Snackbar.Add("Alert type created successfully", Severity.Success);
                    await OnSaveSuccess.InvokeAsync();
                }
                else
                {
                    Snackbar.Add(result.Error?.Message ?? "Failed to create alert type", Severity.Error);
                }
            }
            else
            {
                var request = new UpdateAlertTypeRequest(
                    _model.Name,
                    _model.Description,
                    _model.Color,
                    _model.NotifyUserIds);

                var result = await AlertTypeService.UpdateAsync(AlertType.Id, request);

                if (result.IsSuccess)
                {
                    Snackbar.Add("Alert type updated successfully", Severity.Success);
                    await OnSaveSuccess.InvokeAsync();
                }
                else
                {
                    Snackbar.Add(result.Error?.Message ?? "Failed to update alert type", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Color { get; set; } = "#0d6efd";
        public List<string> NotifyUserIds { get; set; } = new();
    }
}
