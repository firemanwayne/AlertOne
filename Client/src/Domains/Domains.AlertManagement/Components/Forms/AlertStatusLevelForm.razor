@namespace Domains.AlertManagement.Forms

@inject IAlertStatusLevelService AlertStatusLevelService
@inject ISnackbar Snackbar

<MudCard Elevation="2">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@(StatusLevel == null ? "Create Alert Status Level" : "Edit Alert Status Level")</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudTextField T="string"
                          @bind-Value="_model.Name"
                          Label="Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Name is required"
                          MaxLength="100"
                          HelperText="e.g. Critical, Warning, Info"
                          Class="mb-4" />

            <MudTextField T="string"
                          @bind-Value="_model.Description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Required="true"
                          RequiredError="Description is required"
                          MaxLength="500"
                          HelperText="Describe when this status level is used"
                          Class="mb-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Colors</MudText>

            <div class="d-flex align-center gap-4 mb-4">
                <MudColorPicker @bind-Text="_model.BackgroundColor"
                                Label="Background Color"
                                Variant="Variant.Outlined"
                                DisableToolbar="false"
                                DisableAlpha="true"
                                PickerVariant="PickerVariant.Inline" />
                <MudAvatar Size="Size.Large" Style="@($"background-color: {_model.BackgroundColor};")"> </MudAvatar>
            </div>

            <div class="d-flex align-center gap-4 mb-4">
                <MudColorPicker @bind-Text="_model.TextColor"
                                Label="Text Color"
                                Variant="Variant.Outlined"
                                DisableToolbar="false"
                                DisableAlpha="true"
                                PickerVariant="PickerVariant.Inline" />
                <MudAvatar Size="Size.Large" Style="@($"background-color: {_model.TextColor};")"> </MudAvatar>
            </div>

            <MudText Typo="Typo.subtitle2" Class="mb-2">Combined Preview</MudText>
            <MudChip T="string"
                     Style="@($"background-color: {_model.BackgroundColor}; color: {_model.TextColor};")"
                     Size="Size.Large"
                     Class="mb-4">
                Sample Status Text
            </MudChip>

            <MudSwitch T="bool"
                       @bind-Value="_model.SendNotifications"
                       Label="Send notifications when this status level is applied"
                       Color="Color.Primary"
                       Class="mb-4" />

            <MudSwitch T="bool"
                       @bind-Value="_model.IsDefault"
                       Label="Default status (automatically assigned when alerts are created)"
                       Color="Color.Info"
                       Class="mb-4" />

            <MudSwitch T="bool"
                       @bind-Value="_model.IsCanceled"
                       Label="Canceled status (automatically assigned when alerts are rescinded)"
                       Color="Color.Warning"
                       Class="mb-4" />
        </MudForm>
    </MudCardContent>
    <MudCardActions Class="pa-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!_formIsValid || _isLoading)"
                   OnClick="@HandleSubmitAsync">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>@(StatusLevel == null ? "Create" : "Save Changes")</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="@OnCancelClicked"
                   Disabled="@_isLoading"
                   Class="ml-2">
            Cancel
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter]
    public AlertStatusLevelViewModel? StatusLevel { get; set; }

    [Parameter]
    public EventCallback OnSaveSuccess { get; set; }

    [Parameter]
    public EventCallback OnCancelClicked { get; set; }

    private MudForm _form = null!;
    private FormModel _model = new();
    private bool _isLoading = false;
    private bool _formIsValid = false;

    protected override void OnParametersSet()
    {
        if (StatusLevel != null)
        {
            _model = new FormModel
            {
                Name = StatusLevel.Name,
                Description = StatusLevel.Description,
                BackgroundColor = StatusLevel.BackgroundColor,
                TextColor = StatusLevel.TextColor,
                SendNotifications = StatusLevel.SendNotifications,
                IsDefault = StatusLevel.IsDefault,
                IsCanceled = StatusLevel.IsCanceled
            };
        }
        else
        {
            _model = new FormModel();
        }
    }

    private async Task HandleSubmitAsync()
    {
        await _form.Validate();

        if (!_form.IsValid)
        {
            return;
        }

        _isLoading = true;

        try
        {
            if (StatusLevel == null)
            {
                var request = new CreateAlertStatusLevelRequest(
                    _model.Name,
                    _model.Description,
                    _model.BackgroundColor,
                    _model.TextColor,
                    _model.SendNotifications,
                    _model.IsDefault,
                    _model.IsCanceled);

                var result = await AlertStatusLevelService.CreateAsync(request);

                if (result.IsSuccess)
                {
                    Snackbar.Add("Status level created successfully", Severity.Success);
                    await OnSaveSuccess.InvokeAsync();
                }
                else
                {
                    Snackbar.Add(result.Error?.Message ?? "Failed to create status level", Severity.Error);
                }
            }
            else
            {
                var request = new UpdateAlertStatusLevelRequest(
                    _model.Name,
                    _model.Description,
                    _model.BackgroundColor,
                    _model.TextColor,
                    _model.SendNotifications,
                    _model.IsDefault,
                    _model.IsCanceled);

                var result = await AlertStatusLevelService.UpdateAsync(StatusLevel.Id, request);

                if (result.IsSuccess)
                {
                    Snackbar.Add("Status level updated successfully", Severity.Success);
                    await OnSaveSuccess.InvokeAsync();
                }
                else
                {
                    Snackbar.Add(result.Error?.Message ?? "Failed to update status level", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string BackgroundColor { get; set; } = "#6c757d";
        public string TextColor { get; set; } = "#ffffff";
        public bool SendNotifications { get; set; } = true;
        public bool IsDefault { get; set; }
        public bool IsCanceled { get; set; }
    }
}
