@page "/alerts/types"
@attribute [Authorize]

@inject IAlertTypeService AlertTypeService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <AlertTypeList @ref="_listRef"
                   OnCreate="@HandleCreate"
                   OnEdit="@HandleEdit"
                   OnDelete="@HandleDelete" />
</MudContainer>

@code {
    private AlertTypeList? _listRef;

    private void HandleCreate()
    {
        Navigation.NavigateTo("/alerts/types/create");
    }

    private void HandleEdit(AlertTypeViewModel alertType)
    {
        Navigation.NavigateTo($"/alerts/types/edit/{alertType.Id}");
    }

    private async Task HandleDelete(AlertTypeViewModel alertType)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete '{alertType.Name}'?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Alert Type", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            var deleteResult = await AlertTypeService.DeleteAsync(alertType.Id);

            if (deleteResult.IsSuccess)
            {
                Snackbar.Add($"'{alertType.Name}' deleted successfully", Severity.Success);

                if (_listRef != null)
                {
                    await _listRef.RefreshAsync();
                }
            }
            else
            {
                Snackbar.Add($"Failed to delete: {deleteResult.Error?.Message}", Severity.Error);
            }
        }
    }
}
