@page "/alerts/types/edit/{id}"
@attribute [Authorize]

@inject IAlertTypeService AlertTypeService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudButton Variant="Variant.Text"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@HandleBack"
               Class="mb-4">
        Back to Alert Types
    </MudButton>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
    else if (_alertType == null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            <MudText Typo="Typo.h6">Alert Type Not Found</MudText>
            <MudText>The requested alert type could not be found.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@HandleBack" Class="mt-2">
                Back to List
            </MudButton>
        </MudAlert>
    }
    else
    {
        <AlertTypeForm AlertType="@_alertType"
                       OnSaveSuccess="@HandleSaveSuccess"
                       OnCancelClicked="@HandleBack" />
    }
</MudContainer>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private AlertTypeViewModel? _alertType;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        if (!string.IsNullOrWhiteSpace(Id))
        {
            var result = await AlertTypeService.GetByIdAsync(Id);
            _alertType = result.IsSuccess ? AlertTypeViewModel.FromResponse(result.Value) : null;
        }
        else
        {
            _alertType = null;
        }

        _isLoading = false;
    }

    private void HandleSaveSuccess()
    {
        Navigation.NavigateTo("/alerts/types");
    }

    private void HandleBack()
    {
        Navigation.NavigateTo("/alerts/types");
    }
}
