@page "/alerts/status-levels"
@attribute [Authorize]

@inject IAlertStatusLevelService AlertStatusLevelService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <AlertStatusLevelList @ref="_listRef"
                          OnCreate="@HandleCreate"
                          OnEdit="@HandleEdit"
                          OnDelete="@HandleDelete" />
</MudContainer>

@code {
    private AlertStatusLevelList? _listRef;

    private void HandleCreate()
    {
        Navigation.NavigateTo("/alerts/status-levels/create");
    }

    private void HandleEdit(AlertStatusLevelViewModel level)
    {
        Navigation.NavigateTo($"/alerts/status-levels/edit/{level.Id}");
    }

    private async Task HandleDelete(AlertStatusLevelViewModel level)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete '{level.Name}'?" },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Status Level", parameters);

        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            var deleteResult = await AlertStatusLevelService.DeleteAsync(level.Id);

            if (deleteResult.IsSuccess)
            {
                Snackbar.Add($"'{level.Name}' deleted successfully", Severity.Success);

                if (_listRef != null)
                {
                    await _listRef.RefreshAsync();
                }
            }
            else
            {
                Snackbar.Add($"Failed to delete: {deleteResult.Error?.Message}", Severity.Error);
            }
        }
    }
}
