@page "/alerts/status-levels/edit/{id}"
@attribute [Authorize]

@inject IAlertStatusLevelService AlertStatusLevelService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudButton Variant="Variant.Text"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@HandleBack"
               Class="mb-4">
        Back to Status Levels
    </MudButton>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
    else if (_statusLevel == null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            <MudText Typo="Typo.h6">Status Level Not Found</MudText>
            <MudText>The requested status level could not be found.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@HandleBack" Class="mt-2">
                Back to List
            </MudButton>
        </MudAlert>
    }
    else
    {
        <AlertStatusLevelForm StatusLevel="@_statusLevel"
                              OnSaveSuccess="@HandleSaveSuccess"
                              OnCancelClicked="@HandleBack" />
    }
</MudContainer>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private AlertStatusLevelViewModel? _statusLevel;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        if (!string.IsNullOrWhiteSpace(Id))
        {
            var result = await AlertStatusLevelService.GetByIdAsync(Id);
            _statusLevel = result.IsSuccess ? AlertStatusLevelViewModel.FromResponse(result.Value) : null;
        }
        else
        {
            _statusLevel = null;
        }

        _isLoading = false;
    }

    private void HandleSaveSuccess()
    {
        Navigation.NavigateTo("/alerts/status-levels");
    }

    private void HandleBack()
    {
        Navigation.NavigateTo("/alerts/status-levels");
    }
}
