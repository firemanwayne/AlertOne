@page "/alerts/{id}"
@attribute [Authorize]

@inject IAlertService AlertService
@inject NavigationManager Navigation
@inject AppState AppState
@inject IAlertStatusLevelService AlertStatusLevelService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudButton Variant="Variant.Text"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/alerts"
               Class="mb-4">
        Back to Alerts
    </MudButton>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
    else if (_alert is null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            <MudText Typo="Typo.h6">Alert Not Found</MudText>
            <MudText>The requested alert could not be found.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/alerts" Class="mt-2">
                Back to Alerts
            </MudButton>
        </MudAlert>
    }
    else
    {
        <MudCard Elevation="2" Class="mb-4" Style="@($"border: 2px solid {_alert.Type.Color};")">
            <MudCardHeader Style="@($"background-color: {_alert.Type.Color}; color: #fff;")">
                <CardHeaderContent>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">@_alert.Type.Name</MudText>
                        <MudChip T="string"
                                 Style="@($"background-color: {_alert.StatusLevel.Color}; color: #fff;")"
                                 Size="Size.Small">
                            @_alert.StatusLevel.Name
                        </MudChip>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    @if (_alert.IsActive)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Active</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">Rescinded</MudChip>
                    }
                    @if (_alert.IsActive && _isManager)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   OnClick="@OpenStatusDialogAsync"
                                   Class="ml-2">
                            Change Status
                        </MudButton>
                    }
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Type Description</MudText>
                        <MudText>@_alert.Type.Description</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Status Level Description</MudText>
                        <MudText>@_alert.StatusLevel.Description</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Created By</MudText>
                        <MudText>@_alert.CreatedBy</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Created At</MudText>
                        <MudText>@_alert.CreatedDate.ToString("MMM d, yyyy h:mm tt")</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Last Modified</MudText>
                        <MudText>@_alert.UpdatedDate.ToString("MMM d, yyyy h:mm tt")</MudText>
                    </MudItem>
                    @if (!_alert.IsActive)
                    {
                        <MudItem xs="12" md="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Rescinded By</MudText>
                            <MudText>@(_alert.RescindedBy ?? "—")</MudText>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Rescinded At</MudText>
                            <MudText>@(_alert.RescindedAt?.ToString("MMM d, yyyy h:mm tt") ?? "—")</MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudPaper Elevation="1">
            <MudToolBar>
                <MudText Typo="Typo.h6">Event History</MudText>
            </MudToolBar>

            @if (!string.IsNullOrEmpty(_historyError))
            {
                <MudAlert Severity="Severity.Error" Class="ma-4">@_historyError</MudAlert>
            }
            else if (!_history.Any())
            {
                <MudAlert Severity="Severity.Info" Class="ma-4">No history entries found.</MudAlert>
            }
            else
            {
                <MudTimeline TimelinePosition="TimelinePosition.Start" Class="pa-4">
                    @foreach (var entry in _history)
                    {
                        <MudTimelineItem Color="@GetEventMudColor(entry.EventType)" Size="Size.Medium">
                            <ItemContent>
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudChip T="string"
                                             Style="@($"background-color: {GetEventColor(entry.EventType)}; color: #fff;")"
                                             Size="Size.Small">
                                        @entry.EventType
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @entry.UpdatedDate.ToString("MMM d, yyyy h:mm tt")
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.body2">by <strong>@entry.UpdatedBy</strong></MudText>
                                @if (!string.IsNullOrWhiteSpace(entry.Notes))
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary font-italic">@entry.Notes</MudText>
                                }
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private AlertViewModel? _alert;
    private List<AlertHistoryViewModel> _history = new();

    private bool _isLoading = true;
    private string? _historyError;

    private List<AlertStatusLevelViewModel> _availableStatusLevels = new();

    private bool _isManager =>
        AppState.CurrentUser?.Roles.Contains("Manager", StringComparer.OrdinalIgnoreCase) == true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _historyError = null;

        if (string.IsNullOrWhiteSpace(Id))
        {
            _alert = null;
            _isLoading = false;
            return;
        }

        var alertTask = AlertService.GetByIdAsync(Id);
        var historyTask = AlertService.GetHistoryAsync(Id);

        await Task.WhenAll(alertTask, historyTask);

        if (alertTask.Result.IsSuccess)
        {
            _alert = AlertViewModel.FromResponse(alertTask.Result.Value);
        }
        else
        {
            _alert = null;
        }

        if (historyTask.Result.IsSuccess)
        {
            _history = historyTask.Result.Value
                .Select(AlertHistoryViewModel.FromResponse)
                .ToList();
        }
        else
        {
            _historyError = historyTask.Result.Error?.Message ?? "Failed to load history.";
        }

        _isLoading = false;
    }

    private async Task OpenStatusDialogAsync()
    {
        if (!_availableStatusLevels.Any())
        {
            var statusLevels = await AlertStatusLevelService.GetAllAsync();

            if (statusLevels.IsSuccess)
            {
                _availableStatusLevels = statusLevels.Value
                    .Select(AlertStatusLevelViewModel.FromResponse)
                    .ToList();
            }
        }

        var parameters = new DialogParameters<ChangeStatusDialog>
        {
            { x => x.AvailableStatusLevels, _availableStatusLevels },
            { x => x.AlertService, AlertService },
            { x => x.AlertId, _alert!.Id },
            { x => x.CurrentUser, AppState.CurrentUser?.Email ?? string.Empty }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ChangeStatusDialog>("Change Status Level", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private static string GetEventColor(string eventType) => eventType switch
    {
        "Created" => "#198754",
        "StatusUpdated" => "#0d6efd",
        "Rescinded" => "#6c757d",
        _ => "#0d6efd"
    };

    private static Color GetEventMudColor(string eventType) => eventType switch
    {
        "Created" => Color.Success,
        "StatusUpdated" => Color.Primary,
        "Rescinded" => Color.Default,
        _ => Color.Primary
    };
}
