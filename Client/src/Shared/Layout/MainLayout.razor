@inherits LayoutComponentBase
@inject AppState AppState
@inject IAuthenticationService AuthService

<div class="page">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <div class="sidebar-header">
                    <h4>User Management</h4>
                </div>
                <nav class="nav flex-column">
                    <div class="user-info px-3 py-2 mb-3">
                        <div class="text-white">
                            <strong>@AppState.CurrentUser?.FullName</strong>
                        </div>
                        <div class="text-white-50 small">@AppState.CurrentUser?.Email</div>
                        <div class="mt-1">
                            @if (AppState.CurrentUser?.Roles != null)
                            {
                                @foreach (var role in AppState.CurrentUser.Roles)
                                {
                                    <span class="badge bg-light text-dark me-1">@role</span>
                                }
                            }
                        </div>
                    </div>

                    <div class="nav-section px-3 mb-1">
                        <span class="nav-section-label">User Management</span>
                    </div>
                    <a href="/" class="nav-link">
                        <span>Home</span>
                    </a>
                    <a href="/users" class="nav-link">
                        <span>Users</span>
                    </a>
                    <a href="/roles" class="nav-link">
                        <span>Roles</span>
                    </a>

                    <div class="nav-section px-3 mt-3 mb-1">
                        <span class="nav-section-label">Alerts</span>
                    </div>
                    <a href="/alerts" class="nav-link">
                        <span>Alerts</span>
                    </a>
                    <a href="/alerts/types" class="nav-link">
                        <span>Alert Types</span>
                    </a>
                    <a href="/alerts/status-levels" class="nav-link">
                        <span>Status Levels</span>
                    </a>
                </nav>
                <div class="sidebar-footer">
                    <button class="btn btn-outline-light w-100" @onclick="@HandleLogoutAsync">
                        Logout
                    </button>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <main class="main">
        <div class="container-fluid py-4">
            @Body
        </div>
    </main>
</div>

<style>
    .page {
        display: flex;
        height: 100vh;
        overflow: hidden;
    }

    .sidebar {
        width: 280px;
        background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        flex-direction: column;
        box-shadow: 2px 0 8px rgba(0,0,0,0.1);
    }

    .sidebar-header {
        padding: 1.5rem 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .sidebar-header h4 {
        margin: 0;
        font-weight: 600;
    }

    .sidebar nav {
        flex: 1;
        padding: 1rem 0;
    }

    .sidebar-footer {
        padding: 1rem;
        border-top: 1px solid rgba(255,255,255,0.1);
    }

    .user-info {
        background: rgba(255,255,255,0.1);
        border-radius: 0.5rem;
    }

    .nav-section-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(255,255,255,0.5);
    }

    .sidebar .nav-link {
        color: rgba(255,255,255,0.85);
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        margin: 0 0.5rem;
        font-size: 0.9rem;
        transition: background 0.15s;
    }

    .sidebar .nav-link:hover,
    .sidebar .nav-link.active {
        background: rgba(255,255,255,0.15);
        color: white;
    }

    .main {
        flex: 1;
        overflow-y: auto;
        background: #f8f9fa;
    }

    @@media (max-width: 768px) {
        .sidebar {
            width: 100%;
            position: absolute;
            z-index: 1000;
            transform: translateX(-100%);
            transition: transform 0.3s;
        }

        .sidebar.show {
            transform: translateX(0);
        }
    }
</style>

@code {
    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
    }
}
