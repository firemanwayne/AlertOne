@inherits LayoutComponentBase
@inject AppState AppState
@inject IAuthenticationService AuthService

<div class="page">
    <AuthorizeView>
        <Authorized Context="state">
            <div class="sidebar @(_sidebarVisible ? "show" : "")">
                <div class="sidebar-header">
                    <h4>Alert One</h4>
                </div>
                <nav class="nav flex-column">
                    <div class="user-info px-3 py-2 mb-3">
                        <div class="text-white">
                            <strong>@AppState.CurrentUser?.FullName</strong>
                        </div>
                        <div class="text-white-50 small">@state.User.GetEmail()</div>
                        <div class="mt-1">
                            @if (AppState.CurrentUser?.Roles != null)
                            {
                                @foreach (var role in AppState.CurrentUser.Roles)
                                {
                                    <span class="badge bg-light text-dark me-1">@role</span>
                                }
                            }
                        </div>
                    </div>

                    <div class="nav-section px-3 mb-1">
                        <span class="nav-section-label">User Management</span>
                    </div>                    
                    <a href="/users" class="nav-link">
                        <span>Users</span>
                    </a>
                    <a href="/roles" class="nav-link">
                        <span>Roles</span>
                    </a>

                    <div class="nav-section px-3 mt-3 mb-1">
                        <span class="nav-section-label">Alerts</span>
                    </div>
                    <a href="/alerts" class="nav-link">
                        <span>Alerts</span>
                    </a>
                    <a href="/alerts/types" class="nav-link">
                        <span>Alert Types</span>
                    </a>
                    <a href="/alerts/status-levels" class="nav-link">
                        <span>Status Levels</span>
                    </a>
                </nav>
                <div class="sidebar-footer">
                    <button class="btn btn-outline-light w-100" @onclick="@HandleLogoutAsync">
                        Logout
                    </button>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    @if (_sidebarVisible)
    {
        <div class="sidebar-backdrop d-md-none" @onclick="@ToggleSidebar"></div>
    }

    <main class="main">
        <header class="top-header">
            <div class="d-flex align-items-center">
                <button class="btn btn-link d-md-none me-2 text-dark" @onclick="@ToggleSidebar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                    </svg>
                </button>              
            </div>
            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <div class="dropdown">
                            <button class="btn btn-link p-0 text-decoration-none dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="profile-icon">
                                    @GetInitials()
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-semibold">@AppState.CurrentUser?.FullName</div>
                                    <div class="text-muted small">@AppState.CurrentUser?.Email</div>
                                </li>
                                <li><a class="dropdown-item" href="/profile">Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item text-danger" @onclick="@HandleLogoutAsync">Logout</button></li>
                            </ul>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>
        <div class="main-content">
            <div class="container-fluid py-4">
                @Body
            </div>
        </div>
    </main>
</div>

@code {
    private bool _sidebarVisible = false;

    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
    }

    private void ToggleSidebar()
    {
        _sidebarVisible = !_sidebarVisible;
    }

    private string GetInitials()
    {
        var fullName = AppState.CurrentUser?.FullName;

        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "?";
        }

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        }

        return parts[0][0].ToString().ToUpperInvariant();
    }
}
