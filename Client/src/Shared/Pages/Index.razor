@page "/"
@attribute [Authorize]

<PageTitle>AlertOne - Home</PageTitle>

@inject AppState AppState
<AuthorizeView>
    <Authorized>
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Class="pa-6 text-center" Elevation="1">
                    <MudText Typo="Typo.h4">Welcome, @AppState.CurrentUser?.FullName!</MudText>
                    <MudText Typo="Typo.body1" Class="mud-text-secondary mt-2">@AppState.CurrentUser?.Email</MudText>
                    <div class="mt-3">
                        @if (AppState.CurrentUser is not null)
                        {
                            @foreach (var role in AppState.CurrentUser.Roles)
                            {
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mx-1">@role</MudChip>
                            }
                        }
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-6" Elevation="1">
                    <MudText Typo="Typo.h5" Class="mb-4">About AlertOne</MudText>
                    <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
                        AlertOne is a centralized alert management system designed to help organizations
                        coordinate emergency communications and keep teams informed during critical situations.
                    </MudText>

                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <div class="d-flex align-start">
                                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Error" Size="Size.Large" Class="mr-3" />
                                <div>
                                    <MudText Typo="Typo.subtitle1">Alert Management</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        Activate, monitor, and rescind alerts with configurable alert types and status levels.
                                    </MudText>
                                </div>
                            </div>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <div class="d-flex align-start">
                                <MudIcon Icon="@Icons.Material.Filled.Notifications" Color="Color.Warning" Size="Size.Large" Class="mr-3" />
                                <div>
                                    <MudText Typo="Typo.subtitle1">Notifications</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        Automatically notify designated personnel when alerts are activated or updated.
                                    </MudText>
                                </div>
                            </div>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <div class="d-flex align-start">
                                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Info" Size="Size.Large" Class="mr-3" />
                                <div>
                                    <MudText Typo="Typo.subtitle1">User Management</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        Manage users, roles, and permissions to control who can activate and respond to alerts.
                                    </MudText>
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Class="cursor-pointer" @onclick="@(() => NavigateToAlerts())">
                    <MudCardContent Class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" Color="Color.Primary" Class="mr-4" />
                        <div>
                            <MudText Typo="Typo.h6">Alert Dashboard</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">View and manage active alerts</MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Class="cursor-pointer" @onclick="@(() => NavigateToUsers())">
                    <MudCardContent Class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Large" Color="Color.Secondary" Class="mr-4" />
                        <div>
                            <MudText Typo="Typo.h6">User Management</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage users and permissions</MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </Authorized>
</AuthorizeView>
@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private void NavigateToAlerts()
    {
        NavigationManager.NavigateTo("/alerts");
    }

    private void NavigateToUsers()
    {
        NavigationManager.NavigateTo("/users");
    }
}
