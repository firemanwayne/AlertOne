@page "/"
@attribute [Authorize]

<PageTitle>AlertOne - Home</PageTitle>

@inject AppState AppState

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-4">
                    <h2>Welcome, @AppState.CurrentUser.FullName!</h2>
                    <p class="text-muted mb-3">@AppState.CurrentUser.Email</p>
                    <div>

                        @foreach (var role in AppState.CurrentUser.Roles)
                        {
                            <span class="badge bg-primary me-1">@role</span>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-3">About AlertOne</h4>
                    <p class="lead text-muted">
                        AlertOne is a centralized alert management system designed to help organizations
                        coordinate emergency communications and keep teams informed during critical situations.
                    </p>
                    <div class="row g-4 mt-2">
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <span class="fs-4 me-3">🚨</span>
                                <div>
                                    <h6 class="mb-1">Alert Management</h6>
                                    <p class="text-muted small mb-0">
                                        Activate, monitor, and rescind alerts with configurable alert types and status levels.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <span class="fs-4 me-3">🔔</span>
                                <div>
                                    <h6 class="mb-1">Notifications</h6>
                                    <p class="text-muted small mb-0">
                                        Automatically notify designated personnel when alerts are activated or updated.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <span class="fs-4 me-3">👥</span>
                                <div>
                                    <h6 class="mb-1">User Management</h6>
                                    <p class="text-muted small mb-0">
                                        Manage users, roles, and permissions to control who can activate and respond to alerts.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <a href="/alerts" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body d-flex align-items-center">
                    <span class="fs-2 me-3">📋</span>
                    <div>
                        <h5 class="card-title mb-1 text-dark">Alert Dashboard</h5>
                        <p class="card-text text-muted small mb-0">View and manage active alerts</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 mb-3">
            <a href="/users" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body d-flex align-items-center">
                    <span class="fs-2 me-3">⚙️</span>
                    <div>
                        <h5 class="card-title mb-1 text-dark">User Management</h5>
                        <p class="card-text text-muted small mb-0">Manage users and permissions</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>