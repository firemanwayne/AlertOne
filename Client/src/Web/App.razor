
<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly"
    AdditionalAssemblies="@(new[] {
typeof(AlertOne.Shared.Blazor._Imports).Assembly,
typeof(Domains.UserManagement._Imports).Assembly,
typeof(Domains.AlertManagement._Imports).Assembly })">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <MudText Typo="Typo.h6" Color="Color.Warning">Sorry, there's nothing at this address.</MudText>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private bool _isDarkMode = false;

    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1a2c4e",
            Secondary = "#8b2332",
            AppbarBackground = "#1a2c4e",
            DrawerBackground = "#1a2c4e",
            DrawerText = "rgba(255,255,255,0.85)",
            DrawerIcon = "rgba(255,255,255,0.85)"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#4a6fa5",
            Secondary = "#c45c6a"
        }
    };
}
