@page "/alerts/{id}"

@attribute [Authorize]

@inject IAlertService AlertService
@inject NavigationManager Navigation
@inject AppState AppState
@inject IAlertStatusLevelService AlertStatusLevelService

<div class="container-fluid mt-4">
    <div class="mb-3">
        <a href="/alerts" class="btn btn-secondary">← Back to Alerts</a>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading alert...</p>
        </div>
    }
    else if (_alert is null)
    {
        <div class="alert alert-danger">
            <h5>Alert Not Found</h5>
            <p>The requested alert could not be found.</p>
            <a href="/alerts" class="btn btn-primary">Back to Alerts</a>
        </div>
    }
    else
    {
        <div class="card mb-4 border-2" style="border-color: @_alert.Type.Color !important;">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background-color: @_alert.Type.Color; color: #fff;">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold fs-5">@_alert.Type.Name</span>
                    <span class="badge" style="background-color: @_alert.StatusLevel.Color; color: #fff;">
                        @_alert.StatusLevel.Name
                    </span>
                </div>
                <div>
                    @if (_alert.IsActive)
                    {
                        <span class="badge bg-danger fs-6">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">Rescinded</span>
                    }
                    @if (_alert.IsActive && _isManager)
                    {
                        <button class="btn btn-light btn-sm fw-semibold ms-2" @onclick="OpenStatusModalAsync">
                            Change Status
                        </button>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <h6 class="text-muted mb-1">Type Description</h6>
                        <p class="mb-0">@_alert.Type.Description</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-1">Status Level Description</h6>
                        <p class="mb-0">@_alert.StatusLevel.Description</p>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted mb-1">Created By</h6>
                        <p class="mb-0">@_alert.Type.Description</p>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted mb-1">Created At</h6>
                        <p class="mb-0">@_alert.StatusLevel.Description</p>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted mb-1">Last Modified By</h6>
                        <p class="mb-0">@(_alert.CreatedBy)</p>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted mb-1">Last Modified At</h6>
                        <p class="mb-0">@_alert.CreatedAt.ToString("MMM d, yyyy h:mm tt")</p>
                    </div>
                    @if (!_alert.IsActive)
                    {
                        <div class="col-md-3">
                            <h6 class="text-muted mb-1">Rescinded By</h6>
                            <p class="mb-0">@(_alert.RescindedBy ?? "—")</p>
                        </div>
                        <div class="col-md-3">
                            <h6 class="text-muted mb-1">Rescinded At</h6>
                            <p class="mb-0">@(_alert.RescindedAt?.ToString("MMM d, yyyy h:mm tt") ?? "—")</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Event History</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_historyError))
                {
                    <div class="alert alert-danger" role="alert">@_historyError</div>
                }
                else if (!_history.Any())
                {
                    <div class="alert alert-info" role="alert">No history entries found.</div>
                }
                else
                {
                    <div class="ps-3">
                        @foreach (var entry in _history)
                        {
                            <div class="d-flex gap-3 mb-4">
                                <div class="d-flex flex-column align-items-center">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                         style="width:36px;height:36px;min-width:36px;background-color:@GetEventColor(entry.EventType);color:#fff;">
                                        @GetEventIcon(entry.EventType)
                                    </div>
                                    <div style="width:2px;background-color:#dee2e6;margin-top:4px;flex:1;"></div>
                                </div>
                                <div class="pb-3">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge" style="background-color:@GetEventColor(entry.EventType);color:#fff;">
                                            @entry.EventType
                                        </span>
                                        <span class="small text-muted">
                                            @entry.ChangedAt.ToString("MMM d, yyyy h:mm tt")
                                        </span>
                                    </div>
                                    <p class="mb-1 small">by <strong>@entry.ChangedBy</strong></p>
                                    @if (!string.IsNullOrWhiteSpace(entry.Notes))
                                    {
                                        <p class="mb-0 small text-muted fst-italic">@entry.Notes</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (_showStatusModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Change Status Level</h5>
                    <button type="button" class="btn-close" @onclick="CloseStatusModal" disabled="@_isSaving"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div class="alert alert-danger" role="alert">@_modalError</div>
                    }
                    <div class="mb-3">
                        <label for="statusLevelSelect" class="form-label fw-semibold">New Status Level</label>
                        <select id="statusLevelSelect" class="form-select" @bind="_selectedStatusLevelId" disabled="@_isSaving">
                            <option value="@Guid.Empty">— Select a status level —</option>
                            @foreach (var level in _availableStatusLevels)
                            {
                                <option value="@level.Id">@level.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseStatusModal" disabled="@_isSaving">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveStatusAsync" disabled="@(_isSaving || _selectedStatusLevelId == Guid.Empty)">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Confirm</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;    

    private AlertViewModel? _alert;
    private List<AlertHistoryViewModel> _history = new();

    private bool _isLoading = true;
    private string? _historyError;

    private bool _showStatusModal = false;
    private bool _isSaving = false;
    private string? _modalError;
    private List<AlertStatusLevelViewModel> _availableStatusLevels = new();
    private Guid _selectedStatusLevelId = Guid.Empty;

    private bool _isManager =>
        AppState.CurrentUser?.Roles.Contains("Manager", StringComparer.OrdinalIgnoreCase) == true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _historyError = null;

        if (!Guid.TryParse(Id, out var guid))
        {
            _alert = null;
            _isLoading = false;
            return;
        }

        var alertTask = AlertService.GetByIdAsync(guid);

        var historyTask = AlertService.GetHistoryAsync(guid);

        await Task.WhenAll(alertTask, historyTask);

        if (alertTask.Result.IsSuccess)
        {
            _alert = AlertViewModel.FromResponse(alertTask.Result.Value);
        }
        else
        {
            _alert = null;
        }

        if (historyTask.Result.IsSuccess)
        {
            _history = historyTask.Result.Value
                .Select(AlertHistoryViewModel.FromResponse)
                .ToList();
        }
        else
        {
            _historyError = historyTask.Result.Error?.Message ?? "Failed to load history.";
        }

        _isLoading = false;
    }

    private async Task OpenStatusModalAsync()
    {
        _modalError = null;
        _selectedStatusLevelId = Guid.Empty;

        if (!_availableStatusLevels.Any())
        {
            var result = await AlertStatusLevelService.GetAllAsync();

            if (result.IsSuccess)
            {
                _availableStatusLevels = result.Value
                    .Select(AlertStatusLevelViewModel.FromResponse)
                    .ToList();
            }
        }

        _showStatusModal = true;
    }

    private void CloseStatusModal()
    {
        _showStatusModal = false;
        _modalError = null;
    }

    private async Task SaveStatusAsync()
    {
        if (_alert is null || _selectedStatusLevelId == Guid.Empty)
        {
            return;
        }

        _isSaving = true;
        _modalError = null;

        try
        {
            var request = new UpdateAlertStatusRequest(
                _selectedStatusLevelId,
                AppState.CurrentUser?.Email ?? string.Empty);

            var result = await AlertService.UpdateStatusAsync(Guid.Parse(_alert.Id), request);

            if (result.IsSuccess)
            {
                _alert = AlertViewModel.FromResponse(result.Value);
                _showStatusModal = false;

                var historyResult = await AlertService.GetHistoryAsync(Guid.Parse(_alert.Id));

                if (historyResult.IsSuccess)
                {
                    _history = historyResult.Value
                        .Select(AlertHistoryViewModel.FromResponse)
                        .ToList();
                }
            }
            else
            {
                _modalError = result.Error?.Message ?? "Failed to update status.";
            }
        }
        catch (Exception ex)
        {
            _modalError = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string GetEventColor(string eventType) => eventType switch
    {
        "Created" => "#198754",
        "StatusUpdated" => "#0d6efd",
        "Rescinded" => "#6c757d",
        _ => "#0d6efd"
    };

    private static string GetEventIcon(string eventType) => eventType switch
    {
        "Created" => "!",
        "StatusUpdated" => "↑",
        "Rescinded" => "✓",
        _ => "•"
    };
}
