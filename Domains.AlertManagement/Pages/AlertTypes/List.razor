@page "/alerts/types"
@attribute [Authorize]

@inject IAlertTypeService AlertTypeService
@inject NavigationManager Navigation

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Alert Types</h2>
        <button class="btn btn-primary" @onclick="@HandleCreate">
            + New Alert Type
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert alert-info" role="alert">@_statusMessage</div>
    }

    <AlertTypeList @ref="_listRef"
                   OnEdit="@HandleEdit"
                   OnDelete="@HandleDelete" />
</div>

@code {
    private AlertTypeList? _listRef;
    private string? _statusMessage;

    private void HandleCreate()
    {
        Navigation.NavigateTo("/alerts/types/create");
    }

    private void HandleEdit(AlertTypeViewModel alertType)
    {
        Navigation.NavigateTo($"/alerts/types/edit/{alertType.Id}");
    }

    private async Task HandleDelete(AlertTypeViewModel alertType)
    {
        _statusMessage = $"Deleting '{alertType.Name}'...";

        StateHasChanged();

        var result = await AlertTypeService.DeleteAsync(alertType.Id);

        if (result.IsSuccess)
        {
            _statusMessage = $"'{alertType.Name}' deleted successfully.";

            if (_listRef != null)
            {
                await _listRef.RefreshAsync();
            }
        }
        else
        {
            _statusMessage = $"Failed to delete: {result.Error?.Message}";
        }
    }
}
