@page "/alerts/status-levels/create"
@attribute [Authorize]

@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudButton Variant="Variant.Text"
               Color="Color.Default"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@HandleBack"
               Class="mb-4">
        Back to Status Levels
    </MudButton>

    <AlertStatusLevelForm OnSaveSuccess="@HandleSaveSuccess"
                          OnCancelClicked="@HandleBack" />
</MudContainer>

@code {
    private void HandleSaveSuccess()
    {
        Navigation.NavigateTo("/alerts/status-levels");
    }

    private void HandleBack()
    {
        Navigation.NavigateTo("/alerts/status-levels");
    }
}
