@namespace Domains.AlertManagement.Lists

@inject IAlertStatusLevelService AlertStatusLevelService

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Alert Status Levels</h3>
        <button class="btn btn-outline-secondary btn-sm" @onclick="@LoadAsync">
            Refresh
        </button>
    </div>
    <div class="card-body">
        @if (_isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading status levels...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        else if (!_levels.Any())
        {
            <div class="alert alert-info" role="alert">No alert status levels defined.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Color</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Notifications</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var level in _levels)
                        {
                            <tr>
                                <td>
                                    <span class="d-inline-block rounded"
                                          style="width:28px;height:28px;background-color:@level.Color;"
                                          title="@level.Color"></span>
                                </td>
                                <td class="fw-semibold">@level.Name</td>
                                <td class="text-muted">@level.Description</td>
                                <td>
                                    @if (level.SendNotifications)
                                    {
                                        <span class="badge bg-success">Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Disabled</span>
                                    }
                                </td>
                                <td>
                                    @if (level.IsDefault)
                                    {
                                        <span class="badge bg-primary">Default</span>
                                    }
                                    @if (level.IsCanceled)
                                    {
                                        <span class="badge bg-warning text-dark">Canceled</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            @onclick="@(() => OnEdit.InvokeAsync(level))">
                                        Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="@(() => OnDelete.InvokeAsync(level))">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<AlertStatusLevelViewModel> OnEdit { get; set; }

    [Parameter]
    public EventCallback<AlertStatusLevelViewModel> OnDelete { get; set; }

    private List<AlertStatusLevelViewModel> _levels = new();
    private bool _isLoading = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await AlertStatusLevelService.GetAllAsync();

            if (result.IsSuccess)
            {
                _levels = result.Value
                    .Select(AlertStatusLevelViewModel.FromResponse)
                    .ToList();
            }
            else
            {
                _errorMessage = result.Error?.Message ?? "Failed to load status levels.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public async Task RefreshAsync()
    {
        await LoadAsync();
    }
}
