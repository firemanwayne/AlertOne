@namespace Domains.AlertManagement.Lists

@inject IAlertService AlertService
@inject AppState AppState
@inject NavigationManager Navigation

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Alerts</h3>
        <div class="d-flex gap-2 align-items-center">
            <select class="form-select form-select-sm" @bind="_filter" @bind:event="onchange" style="width: auto;">
                <option value="all">All Alerts</option>
                <option value="active">Active Only</option>
                <option value="rescinded">Rescinded Only</option>
            </select>
            <button class="btn btn-outline-secondary btn-sm" @onclick="@LoadAsync">
                Refresh
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (_isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading alerts...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        else if (!FilteredAlerts.Any())
        {
            <div class="alert alert-info" role="alert">No alerts found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="text-align:center">Status</th>
                            <th style="text-align:center">Type</th>
                            <th style="text-align:center">Status</th>
                            <th style="text-align:center">Created By</th>
                            <th style="text-align:center">Created</th>
                            <th style="text-align:center">Last Modified</th>
                            <th style="text-align:center">Rescinded By</th>
                            <th style="text-align:center">Rescinded At</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in FilteredAlerts)
                        {
                            <tr>
                                <td style="text-align:center">
                                    @if (alert.IsActive)
                                    {
                                        <span class="badge bg-danger">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Rescinded</span>
                                    }
                                </td>
                                <td style="text-align:center">
                                    <span class="d-flex align-items-center gap-2">
                                        <span class="rounded-circle d-inline-block"
                                              style="width:12px;height:12px;background-color:@alert.Type.Color;"></span>
                                        @alert.Type.Name
                                    </span>
                                </td>
                                <td style="text-align:center">
                                    <span class="badge"
                                          style="background-color:@alert.StatusLevel.Color;color:#fff;">
                                        @alert.StatusLevel.Name
                                    </span>
                                </td>
                                <td style="text-align:center">@alert.CreatedBy</td>
                                <td style="text-align:center">@alert.CreatedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td style="text-align:center">@alert.LastModifiedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td style="text-align:center">@(alert.RescindedBy ?? "—")</td>
                                <td style="text-align:center">@(alert.RescindedBy ?? "—")</td>
                                <td style="text-align:center">
                                    <a href="/alerts/@alert.Id" class="btn btn-outline-primary btn-sm">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mt-2">
                Showing @FilteredAlerts.Count() of @_alerts.Count alerts
            </p>
        }
    </div>
</div>

@code {
    private List<AlertViewModel> _alerts = new();
    private bool _isLoading = false;
    private string? _errorMessage;
    private string _filter = "all";

    private IEnumerable<AlertViewModel> FilteredAlerts => _filter switch
    {
        "active" => _alerts.Where(a => a.IsActive),
        "rescinded" => _alerts.Where(a => !a.IsActive),
        _ => _alerts
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await AlertService.GetAllAsync();

            if (result.IsSuccess)
            {
                _alerts = result.Value
                    .OrderByDescending(a => a.CreatedAt)
                    .Select(AlertViewModel.FromResponse)
                    .ToList();
            }
            else
            {
                _errorMessage = result.Error?.Message ?? "Failed to load alerts.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public async Task RefreshAsync()
    {
        await LoadAsync();
    }
}
