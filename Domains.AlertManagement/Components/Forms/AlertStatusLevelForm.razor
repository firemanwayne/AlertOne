@namespace Domains.AlertManagement.Forms

@inject IAlertStatusLevelService AlertStatusLevelService

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@(StatusLevel == null ? "Create Alert Status Level" : "Edit Alert Status Level")</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success" role="alert">@_successMessage</div>
        }

        <EditForm Model="@_model" OnValidSubmit="@HandleSubmitAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label for="slName" class="form-label">Name</label>
                <InputText id="slName" @bind-Value="_model.Name" class="form-control"
                           placeholder="e.g. Critical, Warning, Info" />
                <ValidationMessage For="@(() => _model.Name)" />
            </div>

            <div class="mb-3">
                <label for="slDescription" class="form-label">Description</label>
                <InputTextArea id="slDescription" @bind-Value="_model.Description"
                               class="form-control" rows="3"
                               placeholder="Describe when this status level is used..." />
                <ValidationMessage For="@(() => _model.Description)" />
            </div>

            <div class="mb-3">
                <label for="slColor" class="form-label">Color</label>
                <div class="d-flex align-items-center gap-3">
                    <input type="color" id="slColor" class="form-control form-control-color"
                           @bind="_model.Color" style="width:60px;height:38px;" />
                    <InputText @bind-Value="_model.Color" class="form-control"
                               placeholder="#FF0000" style="max-width:140px;" />
                    <span class="badge fs-6 px-3 py-2"
                          style="background-color:@_model.Color;color:#fff;">
                        Preview
                    </span>
                </div>
                <ValidationMessage For="@(() => _model.Color)" />
            </div>

            <div class="mb-4">
                <div class="form-check form-switch">
                    <InputCheckbox id="slSendNotifications" class="form-check-input"
                                   @bind-Value="_model.SendNotifications" />
                    <label class="form-check-label" for="slSendNotifications">
                        Send notifications when this status level is applied
                    </label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>@(StatusLevel == null ? "Create" : "Save Changes")</span>
                    }
                </button>
                <button type="button" class="btn btn-secondary"
                        @onclick="@OnCancelClicked" disabled="@_isLoading">
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public AlertStatusLevelViewModel? StatusLevel { get; set; }

    [Parameter]
    public EventCallback OnSaveSuccess { get; set; }

    [Parameter]
    public EventCallback OnCancelClicked { get; set; }

    private FormModel _model = new();
    private bool _isLoading = false;
    private string? _errorMessage;
    private string? _successMessage;

    protected override void OnParametersSet()
    {
        if (StatusLevel != null)
        {
            _model = new FormModel
            {
                Name = StatusLevel.Name,
                Description = StatusLevel.Description,
                Color = StatusLevel.Color,
                SendNotifications = StatusLevel.SendNotifications
            };
        }
        else
        {
            _model = new FormModel();
        }
    }

    private async Task HandleSubmitAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            if (StatusLevel == null)
            {
                var request = new CreateAlertStatusLevelRequest(
                    _model.Name,
                    _model.Description,
                    _model.Color,
                    _model.SendNotifications);

                var result = await AlertStatusLevelService.CreateAsync(request);

                if (result.IsSuccess)
                {
                    _successMessage = "Status level created successfully.";
                    await Task.Delay(800);
                    await OnSaveSuccess.InvokeAsync();
                }
                else
                {
                    _errorMessage = result.Error?.Message ?? "Failed to create status level.";
                }
            }
            else
            {
                var request = new UpdateAlertStatusLevelRequest(
                    _model.Name,
                    _model.Description,
                    _model.Color,
                    _model.SendNotifications);

                var result = await AlertStatusLevelService.UpdateAsync(StatusLevel.Id, request);

                if (result.IsSuccess)
                {
                    _successMessage = "Status level updated successfully.";
                    await Task.Delay(800);
                    await OnSaveSuccess.InvokeAsync();
                }
                else
                {
                    _errorMessage = result.Error?.Message ?? "Failed to update status level.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [MaxLength(100, ErrorMessage = "Name cannot exceed 100 characters.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Description is required.")]
        [MaxLength(500, ErrorMessage = "Description cannot exceed 500 characters.")]
        public string Description { get; set; } = string.Empty;

        [Required(ErrorMessage = "Color is required.")]
        [RegularExpression(@"^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
            ErrorMessage = "Color must be a valid hex value (e.g. #FF0000).")]
        public string Color { get; set; } = "#6c757d";

        public bool SendNotifications { get; set; } = true;
    }
}
