@namespace Domains.AlertManagement.Forms

@inject IAlertTypeService AlertTypeService
@inject IUserManagementService UserService

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@(AlertType == null ? "Create Alert Type" : "Edit Alert Type")</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success" role="alert">@_successMessage</div>
        }

        <EditForm Model="@_model" OnValidSubmit="@HandleSubmitAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label for="atName" class="form-label">Name</label>
                <InputText id="atName" @bind-Value="_model.Name" class="form-control"
                           placeholder="e.g. Fire, Medical, Security" />
                <ValidationMessage For="@(() => _model.Name)" />
            </div>

            <div class="mb-3">
                <label for="atDescription" class="form-label">Description</label>
                <InputTextArea id="atDescription" @bind-Value="_model.Description"
                               class="form-control" rows="3"
                               placeholder="Describe what this alert type represents..." />
                <ValidationMessage For="@(() => _model.Description)" />
            </div>

            <div class="mb-3">
                <label for="atColor" class="form-label">Color</label>
                <div class="d-flex align-items-center gap-3">
                    <input type="color" id="atColor" class="form-control form-control-color"
                           @bind="_model.Color" style="width:60px;height:38px;" />
                    <InputText @bind-Value="_model.Color" class="form-control"
                               placeholder="#FF0000" style="max-width:140px;" />
                    <span class="badge fs-6 px-3 py-2"
                          style="background-color:@_model.Color;color:#fff;">
                        Preview
                    </span>
                </div>
                <ValidationMessage For="@(() => _model.Color)" />
            </div>

            <div class="mb-4">
                <label class="form-label">Notify Users</label>
                <p class="text-muted small mb-2">
                    Select the users who will receive notifications when this alert type is activated.
                </p>
                @if (_isLoadingUsers)
                {
                    <div class="d-flex align-items-center gap-2 text-muted small">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        <span>Loading users...</span>
                    </div>
                }
                else if (!_allUsers.Any())
                {
                    <div class="alert alert-info py-2 small">No users available.</div>
                }
                else
                {
                    <div class="border rounded p-3" style="max-height:220px;overflow-y:auto;">
                        <div class="mb-2">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Search users..."
                                   @bind="_userSearch" @bind:event="oninput" />
                        </div>
                        @foreach (var user in FilteredUsers)
                        {
                            var isChecked = _model.NotifyUserIds.Contains(user.Id);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="user-@user.Id"
                                       checked="@isChecked"
                                       @onchange="@(e => ToggleUser(user.Id, (bool)e.Value!))" />
                                <label class="form-check-label" for="user-@user.Id">
                                    @user.FirstName @user.LastName
                                    <span class="text-muted small ms-1">(@user.Email)</span>
                                </label>
                            </div>
                        }
                    </div>
                    <div class="mt-1 small text-muted">
                        @_model.NotifyUserIds.Count user(s) selected
                    </div>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>@(AlertType == null ? "Create" : "Save Changes")</span>
                    }
                </button>
                <button type="button" class="btn btn-secondary"
                        @onclick="@OnCancelClicked" disabled="@_isLoading">
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public AlertTypeViewModel? AlertType { get; set; }

    [Parameter]
    public EventCallback OnSaveSuccess { get; set; }

    [Parameter]
    public EventCallback OnCancelClicked { get; set; }

    private FormModel _model = new();
    private List<UserResponse> _allUsers = new();
    private bool _isLoading = false;
    private bool _isLoadingUsers = false;
    private string? _errorMessage;
    private string? _successMessage;
    private string _userSearch = string.Empty;

    private IEnumerable<UserResponse> FilteredUsers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_userSearch))
            {
                return _allUsers;
            }

            var term = _userSearch.ToLowerInvariant();
            return _allUsers.Where(u =>
                u.Email.ToLowerInvariant().Contains(term) ||
                u.FirstName.ToLowerInvariant().Contains(term) ||
                u.LastName.ToLowerInvariant().Contains(term));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    protected override void OnParametersSet()
    {
        if (AlertType != null)
        {
            _model = new FormModel
            {
                Name = AlertType.Name,
                Description = AlertType.Description,
                Color = AlertType.Color,
                NotifyUserIds = AlertType.NotifyUserIds.ToList()
            };
        }
        else
        {
            _model = new FormModel();
        }
    }

    private async Task LoadUsersAsync()
    {
        _isLoadingUsers = true;

        try
        {
            var result = await UserService.GetAllUsersAsync();

            if (result.IsSuccess)
            {
                _allUsers = result.Value.ToList();
            }
        }
        catch
        {
            // Users list is non-critical; the form can still be submitted without it
        }
        finally
        {
            _isLoadingUsers = false;
        }
    }

    private void ToggleUser(Guid userId, bool selected)
    {
        if (selected)
        {
            if (!_model.NotifyUserIds.Contains(userId))
            {
                _model.NotifyUserIds.Add(userId);
            }
        }
        else
        {
            _model.NotifyUserIds.Remove(userId);
        }
    }

    private async Task HandleSubmitAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            if (AlertType == null)
            {
                var request = new CreateAlertTypeRequest(
                    _model.Name,
                    _model.Description,
                    _model.Color,
                    _model.NotifyUserIds);

                var result = await AlertTypeService.CreateAsync(request);

                if (result.IsSuccess)
                {
                    _successMessage = "Alert type created successfully.";
                    await Task.Delay(800);
                    await OnSaveSuccess.InvokeAsync();
                }
                else
                {
                    _errorMessage = result.Error?.Message ?? "Failed to create alert type.";
                }
            }
            else
            {
                var request = new UpdateAlertTypeRequest(
                    _model.Name,
                    _model.Description,
                    _model.Color,
                    _model.NotifyUserIds);

                var result = await AlertTypeService.UpdateAsync(Guid.Parse(AlertType.Id), request);

                if (result.IsSuccess)
                {
                    _successMessage = "Alert type updated successfully.";
                    await Task.Delay(800);
                    await OnSaveSuccess.InvokeAsync();
                }
                else
                {
                    _errorMessage = result.Error?.Message ?? "Failed to update alert type.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [MaxLength(100, ErrorMessage = "Name cannot exceed 100 characters.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Description is required.")]
        [MaxLength(500, ErrorMessage = "Description cannot exceed 500 characters.")]
        public string Description { get; set; } = string.Empty;

        [Required(ErrorMessage = "Color is required.")]
        [RegularExpression(@"^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
            ErrorMessage = "Color must be a valid hex value (e.g. #FF0000).")]
        public string Color { get; set; } = "#0d6efd";

        public List<Guid> NotifyUserIds { get; set; } = new();
    }
}
