## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Rider
.idea/

# Azure Functions
local.settings.json
__blobstorage__/
__queuestorage__/
__azurite_db*__.json

# Database files
*.db
*.db-shm
*.db-wal

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*

# Build outputs
*.dll
*.exe
*.pdb
*.cache

# Documentation
*.xml

# OS files
.DS_Store
Thumbs.db

# Secrets and settings
appsettings.Development.json
appsettings.*.json
!appsettings.json

# EF Core Migrations (optional - uncomment if you don't want to commit migrations)
# **/Migrations/
